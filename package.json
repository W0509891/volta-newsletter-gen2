{
  "name": "volta-newsletter-gen2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import=tsx --test tests/*.test.ts",
    "db:migrate:dev": "node --env-file=.env.development scripts/migrate.js",
    "db:migrate:prod": "node --env-file=.env.production scripts/migrate.js",
    "db:seed:dev": "node --env-file=.env.development --import=tsx scripts/seed.ts",
    "db:seed:prod": "node --env-file=.env.production --import=tsx scripts/seed.ts",
    "news:aggregate": "node --env-file=.env --import=tsx workers/aggregate-news.ts",
    "news:digest": "node --env-file=.env --import=tsx workers/send-news-digest.ts"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "@tailwindcss/postcss": "^4",
    "next": "16.3.5"
  },
  "devDependencies": {
    "zod": "^4.6.5",
    "react": "19.2.8",
    "pug": "^3.0.4",
    "react-dom": "19.2.8",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.23.1",
    "fast-xml-parser": "^5.11.1",
    "juice": "^12.1.3",
    "lucide-react": "^1.47.0",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^20",
    "@types/pug": "^2.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
