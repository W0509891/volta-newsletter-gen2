extends base-layout

block content
  - var sections = newsletter.sections || {}

  //- 1. Featured founder story (hero)
  if sections.featured && sections.featured.length > 0
    - var items = sections.featured
    include sections/founder-highlight

  //- 2. Events ("Coming up")
  if sections.events && sections.events.length > 0
    - var items = sections.events
    include sections/events

  //- 3. Stories, wins, opportunities, community ("Around the lab")
  if sections.updates && sections.updates.length > 0
    - var items = sections.updates
    include sections/program-updates
