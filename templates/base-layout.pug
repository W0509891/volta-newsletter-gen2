include mixins

doctype html
html(lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    //- Dark-first email: tell clients not to auto-invert.
    meta(name="color-scheme" content="dark")
    meta(name="supported-color-schemes" content="dark")
    title #{newsletter.subject}
    link(href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600;700&display=swap" rel="stylesheet")
    style(type="text/css").
      :root { color-scheme: dark; supported-color-schemes: dark; }
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
      body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #000000; }
      a { color: #3b9cff; }
      @media only screen and (max-width: 520px) {
        .px { padding-left: 20px !important; padding-right: 20px !important; }
        .stack { display: block !important; width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }
        .hero-title { font-size: 26px !important; }
      }
    //- Outlook falls back to Arial instead of Times.
    <!--[if mso]><style>* { font-family: Arial, sans-serif !important; }</style><![endif]-->

  - var issueLabel = newsletter.scheduledFor ? new Date(newsletter.scheduledFor).toLocaleDateString('en-CA', { month: 'long', year: 'numeric', timeZone: 'America/Halifax' }) : ''

  body(style="margin:0;padding:0;background-color:#000000;")
    if newsletter.previewText
      div(style="display:none;font-size:1px;color:#000000;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;")
        | #{newsletter.previewText}
        | &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;

    table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#000000" style="background-color:#000000;")
      tr
        td(align="center" style="padding:24px 0;")
          <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
          table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#000000" style="max-width:600px;background-color:#000000;")
            //- Masthead
            tr
              td(class="px" style="padding:30px 30px 0 30px;")
                table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
                  tr
                    td(valign="bottom" style=`font-family:${VOLTA_FONT};font-size:28px;font-weight:800;letter-spacing:-1px;color:#ffffff;line-height:1;`) VOLTA
                    if issueLabel
                      td(align="right" valign="bottom" style=`font-family:${VOLTA_FONT};font-size:14px;font-weight:500;color:#9aa0a6;`)= issueLabel

            //- Body
            tr
              td(class="px" style="padding:22px 30px 8px 30px;")
                block content

            //- Footer: spectrum bar, then address + unsubscribe
            tr
              td(style="padding:30px 0 0 0;")
                +spectrumRule(6)
            tr
              td(class="px" style=`padding:22px 30px 28px 30px;font-family:${VOLTA_FONT};font-size:13px;line-height:1.6;color:#7d848b;`)
                p(style="margin:0 0 8px 0;color:#c9ccd0;font-weight:600;") Volta Innovation Hub, Halifax, Nova Scotia
                p(style="margin:0;")
                  | You’re getting this because you build, fund or partner with the Volta community.
                  br
                  a(href="*|UNSUB|*" style="color:#ffffff;text-decoration:underline;") Unsubscribe
          <!--[if mso]></td></tr></table><![endif]-->
