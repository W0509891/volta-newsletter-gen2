doctype html
html(lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title #{newsletter.subject}
    style(type="text/css").
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
      body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f1f5f9; }
      .email-container { max-width: 600px; margin: 0 auto; background-color: #1e293b; border-radius: 8px; overflow: hidden; }
      .header-bg { background-color: #0b1120; padding: 28px 32px; border-bottom: 3px solid #f59e0b; }
      .volta-badge { background-color: #f59e0b; color: #020617; font-weight: 900; font-size: 13px; padding: 4px 10px; border-radius: 4px; letter-spacing: 1.5px; display: inline-block; }
      .newsletter-title { font-size: 20px; font-weight: 700; color: #ffffff; margin: 0; line-height: 1.3; }
      .newsletter-preview { font-size: 14px; color: #94a3b8; margin: 6px 0 0 0; line-height: 1.4; }
      .content-body { padding: 32px 32px; }
      .section-heading { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #f59e0b; margin: 0 0 16px 0; border-bottom: 1px solid #334155; padding-bottom: 8px; }
      .item-card { background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
      .item-title { font-size: 17px; font-weight: 700; color: #ffffff; margin: 0 0 8px 0; line-height: 1.3; }
      .item-summary { font-size: 14px; color: #cbd5e1; line-height: 1.5; margin: 0 0 14px 0; }
      .item-link { display: inline-block; font-size: 13px; font-weight: 600; color: #38bdf8; text-decoration: none; }
      .footer-bg { background-color: #090d16; padding: 28px 32px; text-align: center; font-size: 12px; color: #64748b; line-height: 1.6; }
      .footer-link { color: #94a3b8; text-decoration: underline; }
  body
    // Preview text (hidden hack for email clients)
    if newsletter.previewText
      div(style="display:none;font-size:1px;color:#333333;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;")
        | #{newsletter.previewText}
        | &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;

    table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #0f172a; padding: 24px 0;")
      tr
        td(align="center")
          // Email Container
          table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 600px; background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; overflow: hidden;")
            // Header
            tr
              td(class="header-bg" style="background-color: #0b1120; padding: 28px 32px; border-bottom: 3px solid #f59e0b;")
                table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
                  tr
                    td
                      span(class="volta-badge" style="background-color: #f59e0b; color: #020617; font-weight: 900; font-size: 12px; padding: 4px 8px; border-radius: 4px; letter-spacing: 1px;") VOLTA
                      h1(class="newsletter-title" style="font-size: 20px; font-weight: 700; color: #ffffff; margin: 12px 0 0 0;") #{newsletter.subject}
                      if newsletter.previewText
                        p(class="newsletter-preview" style="font-size: 14px; color: #94a3b8; margin: 6px 0 0 0;") #{newsletter.previewText}

            // Body
            tr
              td(class="content-body" style="padding: 32px 32px;")
                block content

            // Footer
            tr
              td(class="footer-bg" style="background-color: #090d16; padding: 28px 32px; text-align: center; font-size: 12px; color: #64748b; line-height: 1.6;")
                p(style="margin: 0 0 8px 0; color: #94a3b8; font-weight: 600;") Volta Innovation Hub &middot; AI Builders Community
                p(style="margin: 0 0 12px 0;") Halifax, Nova Scotia &middot; Practice &middot; Build &middot; Scale
                p(style="margin: 0; color: #64748b;")
                  | You are receiving this dispatch because you are an active builder, founder, or partner in the Volta ecosystem.
                  br
                  | If you wish to stop receiving these dispatches, you may 
                  a(href="*|UNSUB|*" class="footer-link" style="color: #f59e0b; text-decoration: underline;") unsubscribe here
                  | .
