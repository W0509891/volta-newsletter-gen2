if items && items.length > 0
  div(style="margin-bottom: 24px;")
    h3(class="section-heading" style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #f59e0b; margin: 0 0 16px 0; border-bottom: 1px solid #334155; padding-bottom: 8px;")
      | WINS, OPPORTUNITIES &amp; COMMUNITY
    each item in items
      div(class="item-card" style="background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 18px; margin-bottom: 14px;")
        table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
          tr
            td
              div(style="margin-bottom: 4px;")
                span(style="display: inline-block; font-size: 10px; font-weight: 800; text-transform: uppercase; color: #38bdf8; letter-spacing: 1px;") #{item.type}
              h4(class="item-title" style="font-size: 16px; font-weight: 700; color: #ffffff; margin: 0 0 6px 0; line-height: 1.3;") #{item.title}
              if item.summary
                p(class="item-summary" style="font-size: 13.5px; color: #cbd5e1; line-height: 1.5; margin: 0 0 10px 0;") #{item.summary}
              if item.url || item.trackedUrl
                a(href=(item.trackedUrl || item.url) class="item-link" style="display: inline-block; font-size: 13px; font-weight: 600; color: #38bdf8; text-decoration: none;") Learn more &rarr;
