//- "Around the lab": two-up tile grid that stacks on phones.
//- An odd last item spans both columns.
- var typeLabel = function (t) { return t ? t.charAt(0) + t.slice(1).toLowerCase() : '' }

if items && items.length > 0
  +sectionHeading('Around the lab')
  - var rows = []
  - for (var r = 0; r < items.length; r += 2) rows.push(items.slice(r, r + 2))
  table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
    each row in rows
      tr
        each item, j in row
          - var solo = row.length === 1
          - var pad = solo ? 'padding:0 0 12px 0;' : (j === 0 ? 'padding:0 6px 12px 0;' : 'padding:0 0 12px 6px;')
          td(class=(solo ? null : 'stack') width=(solo ? '100%' : '50%') colspan=(solo ? 2 : 1) valign="top" style=pad)
            table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" height="100%")
              tr
                td(bgcolor="#07090c" valign="top" style="padding:16px;border:1px solid #232a30;border-radius:14px;background-color:#07090c;")
                  div(style=`font-family:${VOLTA_FONT};font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#25c7d9;`)= typeLabel(item.type)
                  h4(style=`font-family:${VOLTA_FONT};font-size:16px;font-weight:700;letter-spacing:-0.15px;line-height:1.3;color:#ffffff;margin:8px 0 6px 0;`)= item.title
                  if item.summary
                    p(style=`font-family:${VOLTA_FONT};font-size:14px;line-height:1.5;color:#9aa0a6;margin:0 0 10px 0;`)= item.summary
                  if item.url || item.trackedUrl
                    +textLink(item.trackedUrl || item.url, 'Learn more')
