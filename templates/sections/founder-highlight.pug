if items && items.length > 0
  each item in items
    div(class="item-card" style="background-color: #0f172a; border: 2px solid #f59e0b; border-radius: 8px; padding: 24px; margin-bottom: 28px;")
      table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
        tr
          td
            span(style="display: inline-block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #f59e0b; margin-bottom: 8px;") &star; FEATURED BUILDER STORY
            h2(class="item-title" style="font-size: 20px; font-weight: 700; color: #ffffff; margin: 6px 0 12px 0; line-height: 1.3;") #{item.title}
            if item.summary
              p(class="item-summary" style="font-size: 15px; color: #e2e8f0; line-height: 1.6; margin: 0 0 16px 0;") #{item.summary}
            if item.body
              div(style="font-size: 14px; color: #94a3b8; line-height: 1.5; margin: 0 0 16px 0; border-left: 2px solid #334155; padding-left: 12px;")
                p(style="margin: 0;") #{item.body}
            if item.url || item.trackedUrl
              a(href=(item.trackedUrl || item.url) class="item-link" style="display: inline-block; background-color: #f59e0b; color: #020617; font-size: 13px; font-weight: 700; text-decoration: none; padding: 8px 16px; border-radius: 4px;") Read Founder Breakdown &rarr;
