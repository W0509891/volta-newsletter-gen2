if items && items.length > 0
  div(style="margin-bottom: 28px;")
    h3(class="section-heading" style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #f59e0b; margin: 0 0 16px 0; border-bottom: 1px solid #334155; padding-bottom: 8px;")
      | UPCOMING PRACTICE SESSIONS &amp; WORKSHOPS
    each item in items
      div(class="item-card" style="background-color: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 20px; margin-bottom: 16px;")
        table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
          tr
            td
              h4(class="item-title" style="font-size: 16px; font-weight: 700; color: #ffffff; margin: 0 0 8px 0; line-height: 1.3;") #{item.title}
              if item.summary
                p(class="item-summary" style="font-size: 14px; color: #cbd5e1; line-height: 1.5; margin: 0 0 12px 0;") #{item.summary}
              if item.url || item.trackedUrl
                a(href=(item.trackedUrl || item.url) class="item-link" style="display: inline-block; font-size: 13px; font-weight: 600; color: #38bdf8; text-decoration: none;") RSVP / Join Workshop &rarr;
