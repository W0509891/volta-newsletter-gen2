//- "Coming up". If an item has eventStartsAt, a big date column is shown;
//- otherwise the row is a single full-width cell.
if items && items.length > 0
  +sectionHeading('Coming up')
  table(role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%")
    each item, i in items
      - var start = item.eventStartsAt ? new Date(item.eventStartsAt) : null
      - var day = start ? start.toLocaleDateString('en-CA', { day: 'numeric', timeZone: 'America/Halifax' }) : null
      - var mon = start ? start.toLocaleDateString('en-CA', { month: 'short', timeZone: 'America/Halifax' }) : null
      - var rowBorder = i === 0 ? '' : 'border-top:1px solid #1c2226;'
      tr
        if day
          td(width="78" valign="top" style=`${rowBorder}padding:14px 14px 14px 0;`)
            div(style=`font-family:${VOLTA_FONT};font-size:34px;font-weight:700;letter-spacing:-1px;line-height:1;color:#25c7d9;`)= day
            div(style=`font-family:${VOLTA_FONT};font-size:13px;font-weight:600;color:#9aa0a6;margin-top:4px;`)= mon
        td(valign="top" colspan=(day ? 1 : 2) style=`${rowBorder}padding:14px 0;`)
          h4(style=`font-family:${VOLTA_FONT};font-size:16px;font-weight:700;letter-spacing:-0.15px;line-height:1.3;color:#ffffff;margin:0 0 4px 0;`)= item.title
          if item.summary
            p(style=`font-family:${VOLTA_FONT};font-size:14px;line-height:1.5;color:#9aa0a6;margin:0 0 6px 0;`)= item.summary
          if item.url || item.trackedUrl
            +textLink(item.trackedUrl || item.url, 'Save a spot')
